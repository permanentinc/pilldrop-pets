{% comment %}
  Single article
{% endcomment %}

<section class="article-hero">
  <div class="article-hero__text">
    <div class="article-hero__text__constraint">
      <a href="{{ blog.url }}" class="article-hero__text__back">&larr; Back to {{ blog.title }}</a>

      {%- if section.settings.show_date -%}
        <p class="article-hero__text__date">{{ article.published_at | date: '%d %B %Y' }}</p>
      {%- endif -%}

      <h1 class="colour--white">{{ article.title | escape }}</h1>

      {%- if section.settings.show_excerpt -%}
        <div class="article-hero__text__excerpt">
          {%- if article.excerpt != blank -%}
            {{ article.excerpt }}
          {%- else -%}
            <p>{{ article.content | strip_html | truncatewords: 40 }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_image and article.image -%}
    <div class="article-hero__image">
      <img
        loading="lazy"
        srcset="
          {{ article.image | image_url: width: 480 }} 480w,
          {{ article.image | image_url: width: 800 }} 800w,
          {{ article.image | image_url: width: 1200 }} 1200w
        "
        sizes="(max-width: 967px) 100vw, 50vw"
        src="{{ article.image | image_url: width: 1200 }}"
        alt="{{ article.image.alt | escape }}"
        width="{{ article.image.width }}"
        height="{{ article.image.height }}"
      >
    </div>
  {%- endif -%}
</section>

<article class="article">
  <div class="article__content rte">
    {{ article.content }}
  </div>

  {%- if article.tags.size > 0 -%}
    <div class="article__tags">
      {%- for tag in article.tags -%}
        <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="article__tags__item">{{ tag }}</a>
      {%- endfor -%}
    </div>
  {%- endif -%}

  <div class="article__footer">
    {%- assign related_count = 0 -%}
    {%- capture related_articles_html -%}
      {%- for other_article in blog.articles limit: 4 -%}
        {%- if other_article.id != article.id and related_count < 3 -%}
          {%- assign related_count = related_count | plus: 1 -%}
          <a href="{{ other_article.url }}" class="article__related__item">
            <div class="article__related__item__image">
              {%- if other_article.image -%}
                <img
                  loading="lazy"
                  srcset="
                    {{ other_article.image | image_url: width: 480 }} 1x,
                    {{ other_article.image | image_url: width: 960 }} 2x
                  "
                  src="{{ other_article.image | image_url: width: 480 }}"
                  alt="{{ other_article.image.alt | default: other_article.title | escape }}"
                  width="480"
                  height="480"
                >
              {%- endif -%}
            </div>
            <p class="article__related__item__date">{{ other_article.published_at | date: '%d %B %Y' }}</p>
            <h5 class="article__related__item__title colour--red">{{ other_article.title | escape }}</h5>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if related_count > 0 -%}
      <div class="article__related">
        <h2 class="colour--text">More from {{ blog.title }}</h2>
        <div class="article__related__grid">{{ related_articles_html }}</div>
      </div>
    {%- endif -%}
  </div>

  {%- if blog.comments_enabled? -%}
    <div class="article__comments">
      <h3 class="colour--red">
        {{- article.comments_count }} comment{% if article.comments_count != 1 %}s{% endif -%}
      </h3>

      {%- paginate article.comments by 20 -%}
        {%- for comment in article.comments -%}
          <div class="article__comments__item">
            <p class="article__comments__item__author"><strong>{{ comment.author }}</strong></p>
            <p class="article__comments__item__date">{{ comment.created_at | date: '%d %B %Y' }}</p>
            <div class="article__comments__item__content">{{ comment.content }}</div>
          </div>
        {%- endfor -%}

        {%- if paginate.pages > 1 -%}
          <div class="blogs__pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" class="blogs__pagination__prev">&larr; Previous</a>
            {%- endif -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" class="blogs__pagination__next">Next &rarr;</a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endpaginate -%}

      {%- form 'new_comment', article -%}
        {%- if form.posted_successfully? -%}
          <p class="article__comments__success">
            {%- if blog.moderated? -%}
              Your comment was posted successfully. We will publish it in a little while, as our blog is moderated.
            {%- else -%}
              Your comment was posted successfully.
            {%- endif -%}
          </p>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="article__comments__errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <p>
          <label for="CommentAuthor">Name</label>
          <input type="text" id="CommentAuthor" name="comment[author]" value="{{ form.author }}" autocomplete="name" required>
        </p>
        <p>
          <label for="CommentEmail">Email</label>
          <input type="email" id="CommentEmail" name="comment[email]" value="{{ form.email }}" autocomplete="email" required>
        </p>
        <p>
          <label for="CommentBody">Comment</label>
          <textarea id="CommentBody" name="comment[body]" rows="5" required>{{ form.body }}</textarea>
        </p>
        <button type="submit" class="button">Post comment</button>
      {%- endform -%}
    </div>
  {%- endif -%}
</article>

{% schema %}
{
  "name": "Main Article",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "default": true,
      "label": "Show featured image"
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "default": true,
      "label": "Show date"
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "default": true,
      "label": "Show excerpt"
    }
  ]
}
{% endschema %}
