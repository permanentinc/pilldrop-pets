{%- liquid
  assign featured_pet_handles = 'all,cats,dogs,horses' | split: ','
-%}

<section class="collections-index-banner">
  <picture>
    <source
      media="(max-width: 767px)"
      srcset="{{ 'home-page-banner-mobile.jpg' | asset_url }}"
    >
    <img
      src="{{ 'home-page-banner-desktop.jpg' | asset_url }}"
      alt=""
      width="1660"
      height="730"
    >
  </picture>
  <div class="collections-index-banner__content">
    <p class="collections-index__eyebrow colour--red">Shop by pet</p>
    <h1>Browse every collection</h1>
    <p>Find medication, food, flea and worm treatments, supplements, and everyday care by animal or category.</p>
  </div>
</section>

<section class="collections-index">
  <div class="collections-index__pets" aria-label="Shop by animal">
    {%- for handle in featured_pet_handles -%}
      {%- assign pet_collection = collections[handle] -%}
      {%- if pet_collection != blank -%}
        {%- liquid
          assign pet_image = ''
          assign pet_label = pet_collection.title
          assign product_count = pet_collection.all_products_count | default: pet_collection.products_count

          if handle == 'all'
            assign pet_label = 'All animals'
            assign pet_image = 'mini-symbol-red.svg'
          elsif handle == 'cats'
            assign pet_image = 'mini-cat.png'
          elsif handle == 'dogs'
            assign pet_image = 'mini-dog.png'
          elsif handle == 'horses'
            assign pet_image = 'mini-horse.png'
          endif
        -%}
        <a class="collections-index__pet" href="{{ pet_collection.url }}">
          <span>
            <strong>{{ pet_label }}</strong>
            <small>{{ product_count }} products</small>
          </span>
          {%- if pet_image != blank -%}
            <img
              src="{{ pet_image | asset_url }}"
              alt=""
              width="96"
              height="96"
              loading="lazy"
            >
          {%- endif -%}
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="collections-index__heading">
    <h2 class="colour--red">Browse all collections</h2>
  </div>

  <div class="collections-index__grid">
    {%- paginate collections by 48 -%}
      {%- for collection in collections -%}
        {%- liquid
          assign collection_image = collection.image
          assign product_count = collection.all_products_count | default: collection.products_count

          if collection_image == blank and collection.products.first
            assign collection_image = collection.products.first.featured_media.preview_image
          endif
        -%}
        <a class="collections-index__card" href="{{ collection.url }}">
          <span class="collections-index__card__image">
            {%- if collection_image != blank -%}
              <img
                src="{{ collection_image | image_url: width: 700 }}"
                srcset="
                  {{ collection_image | image_url: width: 360 }} 360w,
                  {{ collection_image | image_url: width: 540 }} 540w,
                  {{ collection_image | image_url: width: 700 }} 700w
                "
                sizes="(max-width: 640px) 50vw, (max-width: 980px) 33vw, 25vw"
                alt="{{ collection_image.alt | default: collection.title | escape }}"
                width="{{ collection_image.width | default: 700 }}"
                height="{{ collection_image.height | default: 700 }}"
                loading="lazy"
              >
            {%- else -%}
              <img
                src="{{ 'placeholder.jpg' | asset_url }}"
                alt=""
                width="700"
                height="700"
                loading="lazy"
              >
            {%- endif -%}
          </span>
          <span class="collections-index__card__content">
            <strong>{{ collection.title }}</strong>
            <small>{{ product_count }} products</small>
            <span class="collections-index__card__link">Shop now</span>
          </span>
        </a>
      {%- endfor -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" role="navigation" aria-label="Pagination">
          <ul>
            {%- if paginate.previous -%}
              <li>
                <a href="{{ paginate.previous.url }}" aria-label="Previous page">&laquo; Previous</a>
              </li>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <li>
                  <a href="{{ part.url }}">{{ part.title }}</a>
                </li>
              {%- else -%}
                <li class="active">
                  <span>{{ part.title }}</span>
                </li>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <li>
                <a href="{{ paginate.next.url }}" aria-label="Next page">Next &raquo;</a>
              </li>
            {%- endif -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
