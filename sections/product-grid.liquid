{% comment %}
  Filters
{% endcomment %}
<div class="js-products">
  <div class="filter">
    <div class="filter__wrap">
      <a
        href="/collections/all"
        class="filter__wrap__item [ js-filter-collections ] {% if collection.title == 'Products' %}active{% endif %}"
        data-id="All"
      >
        <p class="colour--red"><b>All</b></p>
      </a>

      <a
        href="/collections/cats"
        class="filter__wrap__item [ js-filter-collections ] {% if collection.title == 'Cats' %}active{% endif %}"
        data-id="Cat"
      >
        <p class="colour--red"><b>Cats</b></p>
        <img src="{{ 'mini-cat.png' | asset_url }}" width="140" height="140" loading="lazy">
      </a>

      <a
        href="/collections/dogs"
        class="filter__wrap__item [ js-filter-collections ] {% if collection.title == 'Dogs' %}active{% endif %}"
        data-id="Dog"
      >
        <p class="colour--red"><b>Dogs</b></p>
        <img src="{{ 'mini-dog.png' | asset_url }}" width="140" height="140" loading="lazy">
      </a>

      <a
        href="/collections/horses"
        class="filter__wrap__item [ js-filter-collections ] {% if collection.title == 'Horses' %}active{% endif %}"
        data-id="Horse"
      >
        <p class="colour--red"><b>Horses</b></p>
        <img src="{{ 'mini-horse.png' | asset_url }}" width="140" height="140" loading="lazy">
      </a>
    </div>
  </div>

  <a href="#" class="filter__toggle" onclick="event.preventDefault();document.body.classList.toggle('filters-active')">
    <span class="[ js-toggle-filters-text ]">Show Filters</span>
    <span class="filter-icon">
      <b><i></i></b>
      <b><i></i></b>
      <b><i></i></b>
    </span>
  </a>

  {% comment %}
    Product grid
  {% endcomment %}

  <div class="collection">
    {% comment %}
      Product Filters
    {% endcomment %}
    <div class="collection__filters">
      <h4 class="colour--red">Shop by....</h4>

      {{ 'component-facets.css' | asset_url | stylesheet_tag }}
      <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
      {% render 'facets',
        results: collection,
        mode: 'collection',
        enable_filtering: true,
        enable_sorting: true,
        filter_type: 'vertical',
        paginate: paginate
      %}

      {% comment %}
        <a
          href="#"
          class="collection__filters__toggle"
          onclick="event.preventDefault();document.body.classList.toggle('filters-active')"
        >
          <span>
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="11" viewBox="0 0 15 11">
              <polygon fill="#000" fill-rule="evenodd" points="14.7 4.776 3.12 4.776 6.652 1.245 5.502 .095 0 5.597 5.502 11.1 6.652 9.95 3.12 6.419 14.7 6.419"/>
            </svg>
            CLOSE</span
          >
        </a>

        <h4 class="colour--red">Shop by....</h4>

        <h6 class="collection__filters__title">Condition</h6>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Skin and Allergy" id="Skin and Allergy">
          <label for="Skin and Allergy">Skin and Allergy</label>
        </p>

        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Skin" id="Skin">
          <label for="Skin">Skin</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Cardiac" id="Cardiac">
          <label for="Cardiac">Cardiac</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Diabetes" id="Diabetes">
          <label for="Diabetes">Diabetes</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Behavioural" id="Behavioural">
          <label for="Behavioural">Behavioural</label>
        </p>
        <p class="collection__filters__item">
          <input
            type="checkbox"
            class="[ js-filter-tags ]"
            value="Pain and Anti-inflammatory"
            id="Pain and Anti-inflammatory"
          >
          <label for="Pain and Anti-inflammatory">Pain and Anti-inflammatory</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Hyperthyroidism" id="Hyperthyroidism">
          <label for="Hyperthyroidism">Hyperthyroidism</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Eye Health" id="Eye Health">
          <label for="Eye Health">Eye Health</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Food" id="Food">
          <label for="Food">Food</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Flea Treatment" id="Flea Treatment">
          <label for="Flea Treatment">Flea Treatment</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Seizure" id="Seizure">
          <label for="Seizure">Seizure</label>
        </p>

        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Worming" id="Worming">
          <label for="Worming">Worming</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-tags ]" value="Bravecto" id="Bravecto">
          <label for="Bravecto">Bravecto</label>
        </p>

        <br>
        <br>

        <h6 class="collection__filters__title">Manufacturers</h6>

        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="4CYTE" id="4CYTE">
          <label for="4CYTE">4CYTE</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Bravecto" id="Bravecto">
          <label for="Bravecto">Bravecto</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Dechra" id="Dechra">
          <label for="Dechra">Dechra</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="MSD Animal Health" id="MSD Animal Health">
          <label for="MSD Animal Health">MSD Animal Health</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Elanco" id="Elanco">
          <label for="Elanco">Elanco</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Lantus" id="Lantus">
          <label for="Lantus">Lantus</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Dermcare" id="Dermcare">
          <label for="Dermcare">Dermcare</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Boehringer Ingelheim" id="Boehringer Ingelheim">
          <label for="Boehringer Ingelheim">Boehringer Ingelheim</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Bayer" id="Bayer">
          <label for="Bayer">Bayer</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Vetoquinol" id="Vetoquinol">
          <label for="Vetoquinol">Vetoquinol</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Chanelle" id="Chanelle">
          <label for="Chanelle">Chanelle</label>
        </p>
        <p class="collection__filters__item">
          <input type="checkbox" class="[ js-filter-brands ]" value="Zoetis" id="Zoetis">
          <label for="Zoetis">Zoetis</label>
        </p>
      {% endcomment %}
    </div>

    {% comment %}
      Product grid - CHANGED: Use collection.products instead of collections.all.products
    {% endcomment %}
    <div class="collection__grid">
      <h3
        class="no-results colour--red"
        style="{% if collection.products_count == 0 %}display:block;{% else %}display:none;{% endif %}width: 100%;"
      >
        <br>
        <br>
        There are no results for the selected filters
      </h3>
      <div class="loader">
        <div id="loader">
          <div id="shadow"></div>
          <div id="box"></div>
        </div>
      </div>

      <div
        id="product-grid"
        data-id="{{ section.id }}"
      >
        <div
          id="ProductGridContainer"
          data-id="{{ section.id }}"
        >
          {% comment %} Use collection.products so Shopify handles filtering and pagination. {% endcomment %}
          {% paginate collection.products by 48 %}
            {% for product in collection.products %}
              {% render 'product-grid-card', product: product %}
            {% endfor %}

            {% if paginate.pages > 1 %}
              <nav class="pagination" role="navigation" aria-label="Pagination" style="width: 100%;">
                <ul role="list">
                  {% if paginate.previous %}
                    <li>
                      <a href="{{ paginate.previous.url }}" aria-label="Previous"> &laquo; Previous </a>
                    </li>
                  {% endif %}

                  {% for part in paginate.parts %}
                    <li>
                      {% if part.is_link %}
                        <a href="{{ part.url }}" aria-label="{{ part.title }}">{{ part.title }}</a>
                      {% else %}
                        {% if part.title == paginate.current_page %}
                          <span aria-current="page" aria-label="{{ part.title }}">{{ part.title }}</span>
                        {% else %}
                          <span>{{ part.title }}</span>
                        {% endif %}
                      {% endif %}
                    </li>
                  {% endfor %}

                  {% if paginate.next %}
                    <li>
                      <a href="{{ paginate.next.url }}" aria-label="Next"> Next &raquo; </a>
                    </li>
                  {% endif %}
                </ul>
              </nav>
            {% endif %}
          {% endpaginate %}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Product Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    }
  ],
  "presets": [
    {
      "name": "Product Grid"
    }
  ]
}
{% endschema %}
