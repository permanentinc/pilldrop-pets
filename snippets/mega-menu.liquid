<script>
(function() {
    var menu = document.querySelector('.megamenu');
    var trigger = document.querySelector('[data-mega-trigger]');
    if (!menu || !trigger) return;

    // Toggle on click
    trigger.addEventListener('click', function(e) {
        e.preventDefault();
        menu.classList.toggle('megamenu--active');
    });

    // Close when clicking outside the menu and trigger
    document.addEventListener('click', function(e) {
        if (!menu.classList.contains('megamenu--active')) return;
        if (menu.contains(e.target) || trigger.contains(e.target)) return;
        menu.classList.remove('megamenu--active');
    });

    // Close on scroll past 40px
    window.addEventListener('scroll', function() {
        if (window.scrollY > 40 && menu.classList.contains('megamenu--active')) {
            menu.classList.remove('megamenu--active');
        }
    });

    // Close on small viewport
    function checkViewport() {
        if (window.innerWidth < 1100 && menu.classList.contains('megamenu--active')) {
            menu.classList.remove('megamenu--active');
        }
    }
    window.addEventListener('resize', checkViewport);

    // Close on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && menu.classList.contains('megamenu--active')) {
            menu.classList.remove('megamenu--active');
        }
    });

    // Pet hover → switch category group + show first subcategory
    menu.querySelectorAll('.megamenu__pet').forEach(function(pet) {
        pet.addEventListener('mouseenter', function() {
            var key = this.getAttribute('data-mega-pet');

            menu.querySelectorAll('.megamenu__pet').forEach(function(p) { p.classList.remove('megamenu__pet--active'); });
            this.classList.add('megamenu__pet--active');

            menu.querySelectorAll('.megamenu__category-group').forEach(function(g) { g.style.display = 'none'; });
            var group = menu.querySelector('.megamenu__category-group[data-mega-category="' + key + '"]');

            // Swap pet image
            menu.querySelectorAll('.megamenu__image').forEach(function(img) { img.classList.remove('megamenu__image--active'); });
            var petImg = menu.querySelector('.megamenu__image[data-mega-image="' + key + '"]');
            if (petImg) petImg.classList.add('megamenu__image--active');

            if (group) {
                group.style.display = '';
                group.querySelectorAll('.megamenu__category').forEach(function(c, i) {
                    c.classList.toggle('megamenu__category--active', i === 0);
                });
                var firstCat = group.querySelector('.megamenu__category');
                if (firstCat) {
                    var catKey = firstCat.getAttribute('data-mega-cat');
                    menu.querySelectorAll('.megamenu__subcategory-group').forEach(function(s) { s.style.display = 'none'; });
                    var sub = menu.querySelector('.megamenu__subcategory-group[data-mega-sub="' + catKey + '"]');
                    if (sub) sub.style.display = '';
                }
            }
        });
    });

    // Category hover → switch subcategory group
    menu.querySelectorAll('.megamenu__category').forEach(function(cat) {
        cat.addEventListener('mouseenter', function() {
            var catKey = this.getAttribute('data-mega-cat');
            var group = this.closest('.megamenu__category-group');

            group.querySelectorAll('.megamenu__category').forEach(function(c) { c.classList.remove('megamenu__category--active'); });
            this.classList.add('megamenu__category--active');

            menu.querySelectorAll('.megamenu__subcategory-group').forEach(function(s) { s.style.display = 'none'; });
            var sub = menu.querySelector('.megamenu__subcategory-group[data-mega-sub="' + catKey + '"]');
            if (sub) sub.style.display = '';
        });
    });
})();
</script>
