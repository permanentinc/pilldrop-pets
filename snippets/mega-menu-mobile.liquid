<script>
(function() {
    var mmega = document.querySelector('.mmega');
    if (!mmega) return;

    // Pet tab switching
    mmega.querySelectorAll('.mmega__pet').forEach(function(btn) {
        btn.addEventListener('click', function() {
            mmega.querySelectorAll('.mmega__pet').forEach(function(b) { b.classList.remove('mmega__pet--active'); });
            btn.classList.add('mmega__pet--active');

            var pet = btn.getAttribute('data-mmega-pet');
            mmega.querySelectorAll('.mmega__panel').forEach(function(p) { p.classList.remove('mmega__panel--active'); });
            var panel = mmega.querySelector('.mmega__panel[data-mmega-panel="' + pet + '"]');
            if (panel) panel.classList.add('mmega__panel--active');
        });
    });

    // Accordion toggle
    mmega.querySelectorAll('[data-mmega-toggle]').forEach(function(trigger) {
        trigger.addEventListener('click', function() {
            var accordion = trigger.closest('.mmega__accordion');
            var isOpen = accordion.classList.contains('mmega__accordion--open');

            // Close all accordions in same panel
            trigger.closest('.mmega__panel').querySelectorAll('.mmega__accordion').forEach(function(a) {
                a.classList.remove('mmega__accordion--open');
            });

            if (!isOpen) {
                accordion.classList.add('mmega__accordion--open');
            }
        });
    });
})();
</script>
