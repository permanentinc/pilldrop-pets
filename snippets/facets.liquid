{% comment %}
  Simplified facets - tags grouped by category
  Usage: {% render 'facets', results: collection %}
{% endcomment %}

{%- liquid
  assign tags = 'Skin,Cardiac,Diabetes,Behavioural,Pain and Anti-inflammatory,Hyperthyroidism,Eye Health,Food,Flea Treatment,Seizure,Worming' | split: ','
  assign facet_mode = mode | default: 'collection'
  assign search_value = request.params.q | default: results.terms | default: ''
  assign collection_context = ''

  if facet_mode == 'collection' and collection and collection.handle != 'all'
    assign collection_context = collection.title | downcase
  endif

  if results.url
    assign results_url = results.url
  elsif facet_mode == 'search'
    assign results_url = routes.search_url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms
  endif
-%}

<div class="facets-simple">
  <div class="results-count">
    Showing&nbsp;
    {%- if facet_mode == 'search' -%}
      {%- if search.performed -%}
        {{ results.results_count }} products
      {%- else -%}
        0 products
      {%- endif -%}
    {%- elsif results.results_count -%}
      {{ 'templates.search.results_with_count' | t: terms: results.terms, count: results.results_count }}
    {%- elsif results.products_count == results.all_products_count -%}
      {{ 'products.facets.product_count_simple' | t: count: results.products_count -}}
      {%- if collection_context != blank -%}
        &nbsp;for {{ collection_context }}<br>
        <a class="colour--red" href="{{ routes.all_products_collection_url }}">click here</a> to filter by all animals
      {%- endif -%}
    {%- else -%}
      {{
        'products.facets.product_count'
        | t: product_count: results.products_count, count: results.all_products_count
      }}
      {%- if collection_context != blank -%}
        &nbsp;for {{ collection_context }}<br>
        <a class="colour--red" href="{{ routes.all_products_collection_url }}">click here</a> to filter by all animals
      {%- endif -%}
    {%- endif -%}
  </div>

  <facet-filters-form>
    <form
      id="FacetFiltersForm"
      data-mode="{{ facet_mode }}"
      data-collection-url="{% if facet_mode == 'search' %}{{ routes.all_products_collection_url }}{% else %}{{ results_url }}{% endif %}"
      data-search-url="{{ routes.search_url }}"
    >
      <div class="filter-group filter-group--search">
        <label for="search-query">Refine products</label>
        <input
          class="filter-search-input"
          type="search"
          id="search-query"
          name="q"
          value="{{ search_value | escape }}"
          placeholder="Filter products..."
          autocomplete="off"
        >
      </div>

      <div class="filter-group">
        {% for tag in tags %}
          <label>
            <input
              type="checkbox"
              class="check"
              name="tag"
              value="{{ tag }}"
              {% if current_tags contains tag %}
                checked
              {% endif %}
            >
            {{ tag }}
          </label>
        {%- endfor -%}
      </div>

      {% comment %}
        {%- for filter in results.filters -%}
          {%- if filter.type == 'list' and filter.label == 'Tags' -%}
            <div class="filter-group">
              <h3>Condition</h3>
              {%- for value in filter.values -%}
                {%- if tags contains value.label -%}
                  <label>
                    <input
                      type="checkbox"
                      class="check"
                      name="{{ value.param_name }}"
                      value="{{ value.value }}"
                      {% if value.active %}
                        checked
                      {% endif %}
                    >
                    {{ value.label }} ({{ value.count }})
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {% endcomment %}

      {% comment %}
        <div class="filter-group">
          <h3>All</h3>
          {%- for filter in results.filters -%}
            {%- if filter.type == 'list' -%}
              {%- for value in filter.values -%}
                <label>
                  <input
                    type="checkbox"
                    class="check"
                    name="{{ value.param_name }}"
                    value="{{ value.value }}"
                    {% if value.active %}
                      checked
                    {% endif %}
                  >
                  {{ value.label }} ({{ value.count }})
                </label>
              {%- endfor -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {% endcomment %}

      <a href="{{ results_url }}" class="button button--tiny">Clear filters</a>
    </form>
  </facet-filters-form>
</div>
